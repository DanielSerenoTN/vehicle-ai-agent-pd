{
  "name": "vehicle-ai-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/functions/*/function.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc",
    "watch": "tsc -w",
    "typecheck": "tsc --noEmit",
    "prestart": "npm run clean && npm run build",
    "start": "func start",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@azure/functions": "^4.16.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
